{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:best-practices", ":separateMultipleMajorReleases"],
    "baseBranchPatterns": ["master"],
    "dependencyDashboard": true,
    "configMigration": true,
    "schedule": ["* 0-4 * * *"],
    "timezone": "America/Chicago",
    "prHourlyLimit": 0,
    "prConcurrentLimit": 2,
    "platformAutomerge": false,
    "vulnerabilityAlerts": {
        "enabled": true,
        "groupName": "security updates",
        "vulnerabilityFixStrategy": "lowest"
    },
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": false,
        "schedule": ["* 0-4 * * 1"]
    },
    "packageRules": [
        {
            "description": "Pin direct application dependencies",
            "matchManagers": ["npm"],
            "matchDepTypes": [
                "dependencies",
                "devDependencies",
                "optionalDependencies"
            ],
            "rangeStrategy": "pin"
        },
        {
            "description": "Preserve compatibility ranges",
            "matchManagers": ["npm"],
            "matchDepTypes": ["engines", "peerDependencies"],
            "rangeStrategy": "auto"
        },
        {
            "description": "Keep Node.js on the supported release line",
            "matchPackageNames": ["node"],
            "matchDatasources": ["node-version", "docker"],
            "allowedVersions": "/^24\\./",
            "groupName": "Node.js 24"
        },
        {
            "description": "Group container image digest updates",
            "matchManagers": ["dockerfile"],
            "matchUpdateTypes": ["digest"],
            "groupName": "container image digests"
        },
        {
            "matchUpdateTypes": ["patch"],
            "groupName": "patch updates",
            "minimumReleaseAge": "14 days",
            "minimumReleaseAgeBehaviour": "timestamp-required",
            "internalChecksFilter": "strict",
            "automerge": true
        },
        {
            "matchManagers": ["github-actions"],
            "matchUpdateTypes": ["pinDigest"],
            "groupName": "Pin GitHub Actions digests",
            "automerge": true
        },
        {
            "description": "Review GitHub Actions digest changes",
            "matchManagers": ["github-actions"],
            "matchUpdateTypes": ["digest"],
            "groupName": "GitHub Actions digests",
            "dependencyDashboardApproval": true
        },
        {
            "matchUpdateTypes": ["minor"],
            "groupName": "minor updates",
            "dependencyDashboardApproval": true
        },
        {
            "matchUpdateTypes": ["major"],
            "dependencyDashboardApproval": true
        },
        {
            "matchManagers": ["npm", "custom.regex"],
            "matchPackageNames": ["!node", "!pnpm"],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "pinDigest",
                "digest"
            ],
            "groupName": "library updates",
            "minimumGroupSize": 1,
            "groupSingleUpdates": true
        },
        {
            "matchManagers": ["github-actions"],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "pinDigest",
                "digest"
            ],
            "groupName": "GitHub Actions updates",
            "minimumGroupSize": 1,
            "groupSingleUpdates": true
        },
        {
            "matchManagers": [
                "npm",
                "nvm",
                "nodenv",
                "dockerfile",
                "docker-compose"
            ],
            "matchPackageNames": ["node", "pnpm"],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "pinDigest",
                "digest"
            ],
            "groupName": "toolchain updates",
            "minimumGroupSize": 1,
            "groupSingleUpdates": true
        },
        {
            "matchManagers": ["npm", "custom.regex"],
            "matchPackageNames": ["!node", "!pnpm"],
            "matchUpdateTypes": ["patch"],
            "groupName": "library patch updates",
            "minimumGroupSize": 1,
            "groupSingleUpdates": true
        },
        {
            "matchManagers": ["npm", "custom.regex"],
            "matchPackageNames": ["!node", "!pnpm"],
            "matchUpdateTypes": ["minor"],
            "groupName": "library minor updates",
            "minimumGroupSize": 1,
            "groupSingleUpdates": true
        },
        {
            "matchManagers": [
                "npm",
                "nvm",
                "nodenv",
                "dockerfile",
                "docker-compose"
            ],
            "matchPackageNames": ["node", "pnpm"],
            "matchUpdateTypes": ["patch"],
            "groupName": "toolchain patch updates",
            "minimumGroupSize": 1,
            "groupSingleUpdates": true
        },
        {
            "matchManagers": [
                "npm",
                "nvm",
                "nodenv",
                "dockerfile",
                "docker-compose"
            ],
            "matchPackageNames": ["node", "pnpm"],
            "matchUpdateTypes": ["minor"],
            "groupName": "toolchain minor updates",
            "minimumGroupSize": 1,
            "groupSingleUpdates": true
        },
        {
            "matchManagers": ["github-actions"],
            "matchUpdateTypes": ["patch"],
            "groupName": "GitHub Actions patch updates",
            "minimumGroupSize": 1,
            "groupSingleUpdates": true
        },
        {
            "matchManagers": ["github-actions"],
            "matchUpdateTypes": ["minor", "digest"],
            "groupName": "GitHub Actions review updates",
            "minimumGroupSize": 1,
            "groupSingleUpdates": true
        },
        {
            "matchManagers": ["github-actions"],
            "matchUpdateTypes": ["pinDigest"],
            "groupName": "GitHub Actions pins",
            "minimumGroupSize": 1,
            "groupSingleUpdates": true
        },
        {
            "matchUpdateTypes": ["major"],
            "dependencyDashboardApproval": true
        }
    ],
    "updateNotScheduled": false,
    "branchConcurrentLimit": 2
}
