# OPTIONAL FOR GATEWAY STARTUP; REQUIRED FOR COMMAND DEPLOYMENT
DISCORD_TOKEN="your_discord_token_here"

# REQUIRED FOR COMMAND DEPLOYMENT
CLIENT_ID="your_client_id_here"

# OPTIONAL: DEPLOY COMMANDS TO ONE DEVELOPMENT GUILD INSTEAD OF GLOBALLY
DISCORD_GUILD_ID="your_development_guild_id_here"

# REQUIRED UNLESS LOCAL MOCK MODE IS ENABLED
# The selected SQLite file must be readable by the bot process.
SQLITE_PATH="/data/current.sqlite"

# OPTIONAL: USE LOCAL MOCK DATA DURING DEVELOPMENT ONLY
# pnpm dev and pnpm start set NODE_ENV=development
ENABLE_MOCK_API="false"

# OPTIONAL FOR BETTERSTACK HEARTBEAT MONITORING
BETTERSTACK_HEARTBEAT_URL="your_betterstack_heartbeat_url_here"
