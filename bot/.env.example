# OPTIONAL: ENABLE DISCORD BOT STARTUP AND COMMAND REGISTRATION
CLIENT_ID="your_client_id_here"
DISCORD_TOKEN="your_discord_token_here"

# REQUIRED UNLESS LOCAL MOCK MODE IS ENABLED
API_BASE_URL="your_api_url_here"

# OPTIONAL: USE LOCAL MOCK DATA DURING DEVELOPMENT ONLY
# pnpm dev and pnpm start set NODE_ENV=development
ENABLE_MOCK_API="false"

# OPTIONAL: LOAD DISCORD AUTOCOMPLETE FROM S3
STATIC_BUCKET="your_static_bucket_name_here"
AUTOCOMPLETE_REFRESH_INTERVAL_SECONDS="300"

# OPTIONAL FOR BETTERSTACK HEARTBEAT MONITORING
BETTERSTACK_HEARTBEAT_URL="your_betterstack_heartbeat_url_here"
