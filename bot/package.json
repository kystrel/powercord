{
  "name": "powercord-bot",
  "private": true,
  "version": "0.0.1",
  "main": "src/index.ts",
  "scripts": {
    "prebuild": "node scripts/clean-build.mjs",
    "build": "tsc -p tsconfig.build.json",
    "deploy:commands": "ts-node scripts/deploy-commands.ts",
    "dev": "NODE_ENV=development nodemon",
    "start": "NODE_ENV=development ts-node --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1096.0",
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "pino": "10.3.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.0",
    "match-sorter": "8.3.0",
    "nodemon": "3.1.14",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
