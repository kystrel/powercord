{
  "name": "powercord",
  "version": "0.0.1",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev:bot": "pnpm --filter powercord-bot dev",
    "dev:web": "pnpm --filter powercord-web dev",
    "dev": "concurrently \"pnpm run dev:bot\" \"pnpm run dev:web\"",
    "format": "pnpm run prettier:fix && pnpm run lint:fix",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint -- --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "typecheck": "pnpm --recursive run typecheck",
    "typecheck:bot": "pnpm --filter powercord-bot run typecheck",
    "typecheck:web": "pnpm --filter powercord-web run typecheck",
    "test:bot": "pnpm --filter powercord-bot test",
    "test:bot:coverage": "pnpm --filter powercord-bot run test:coverage",
    "test:web": "pnpm --filter powercord-web test",
    "test:web:coverage": "pnpm --filter powercord-web run test:coverage",
    "clean": "rm -rf node_modules pnpm-lock.yaml bot/node_modules web/node_modules web/.nuxt web/.output web/dist"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@vue/compiler-sfc": "3.5.34",
    "concurrently": "9.2.1",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "typescript-eslint": "8.59.4"
  }
}
